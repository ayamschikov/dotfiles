#!/usr/bin/env bash
# Local review before publishing, with a scope Claude cannot get wrong.
#
#   review branch [--target master] [--tool revdiff|diffx]
#       Only the commits of the current branch: merge-base with a freshly
#       fetched origin/<target> .. HEAD. Uncommitted changes never get in.
#       Commits by other authors stop the review (exit 4) unless
#       --allow-foreign is given: rebase the branch or drop them first.
#       Before the window opens, comment-check reviews the branch's code comments
#       with a fresh-context claude -p: exit 6 = edits for the author, who commits
#       them and reruns; questions for the user go into the revdiff description.
#   review text <draft-file> [--tool revdiff|diffx] [--check-only] [--recheck]
#       A text draft: first checked by text-check (fresh-context claude -p);
#       exit 6 = items for the author, who applies them and reruns. Then revdiff
#       shows only the checker's questions to the user, and the draft as a diff
#       against the version the user saw last time (the whole text the first time).
#       --check-only: the user wrote the text or asked only to check it — no
#       exit 6, every item goes to the user. Edits the user made in the review
#       window are moved into the draft (exit 7, the text becomes the user's);
#       exit 8 = stop and ask the user (see the printed reason).
#       Once the user has reviewed the draft, later versions skip text-check and
#       show only the diff; --recheck (only on the user's request) runs it anyway.
#
# revdiff opens in its own tmux window and blocks until that window is gone
# (quit with q); you can switch to other windows and come back mid-review.
# In branch mode, O hands the annotations over and leaves the window open; the
# next round of the same branch reuses it, and R there reloads the diff while
# keeping the reviewed marks (Space) on files whose diff did not change.
# --popup opens it in a modal popup instead, which holds the client until closed.
# Annotations are printed to stdout for Claude to apply.
# diffx (browser) is started in the foreground — run this in the background.
# Compatible with macOS bash 3.2.
set -u

die() { echo "review: $*" >&2; exit 2; }

mode="${1:-}"; shift || true
target=master; tool=revdiff; file=""; allow_foreign=0; popup=0; check_only=""; recheck=""
while [ $# -gt 0 ]; do
  case "$1" in
    --target) target="$2"; shift 2 ;;
    --tool) tool="$2"; shift 2 ;;
    --allow-foreign) allow_foreign=1; shift ;;
    --popup) popup=1; shift ;;
    --check-only) check_only=--check-only; shift ;;
    --recheck) recheck=--recheck; shift ;;
    -*) die "unknown flag $1" ;;
    *) file="$1"; shift ;;
  esac
done
case "$tool" in revdiff|diffx) ;; *) die "--tool must be revdiff or diffx" ;; esac

out="$(mktemp -t review-annotations)"
desc="$(mktemp -t review-description)"
trap 'rm -f "$out" "$desc" "${old:-}" "${shown:-}"' EXIT

# Set by branch mode: a window kept open between rounds lives under this key.
keep_key=""

# Reviewed marks exist only inside a running revdiff, so the window outlives a
# round: O flushes the annotations (the post-flush hook drops a sentinel), the
# wrapper returns them, and the next round asks for R in the same window.
run_revdiff_kept() {  # $1 = dir, rest = revdiff args
  local dir="$1"; shift
  local st="$HOME/.claude/state/review/$keep_key" win="" args="$*" cmd a kept sess
  mkdir -p "$st"
  cp "$desc" "$st/desc"
  if [ -f "$st/window" ]; then
    win="$(cat "$st/window")"
    tmux list-windows -a -F '#{window_id}' 2>/dev/null | grep -qx "$win" || win=""
    # Another range (origin/<target> moved): the open window shows a stale diff.
    if [ -n "$win" ] && [ "$(cat "$st/args" 2>/dev/null)" != "$args" ]; then
      tmux kill-window -t "$win"; win=""
    fi
  fi
  rm -f "$st/out" "$st/flushed"
  if [ -n "$win" ]; then
    echo "Окно ревью уже открыто: переключаю на него. Нажми R — обновится дифф, галочки на неизменённых файлах останутся."
    tmux select-window -t "$win"
  else
    rm -f "$st/sent"
    printf '#!/bin/sh\ncat >/dev/null\ntouch %q\n' "$st/flushed" > "$st/on-flush"
    chmod +x "$st/on-flush"
    cmd="revdiff --no-confirm-reload --output=$(printf %q "$st/out") --description-file=$(printf %q "$st/desc")"
    cmd="$cmd --post-flush-command=$(printf %q "$st/on-flush")"
    for a in "$@"; do cmd="$cmd $(printf %q "$a")"; done
    sess="$(tmux display-message -p -t "$CLAUDE_TMUX_PANE" '#{session_id}')"
    win="$(tmux new-window -P -F '#{window_id}' -t "$sess" -c "$dir" -n review "$cmd")"
    echo "$win" > "$st/window"
    printf '%s' "$args" > "$st/args"
  fi
  while :; do
    if [ -f "$st/flushed" ]; then kept=1; break; fi
    if ! tmux list-windows -a -F '#{window_id}' 2>/dev/null | grep -qx "$win"; then kept=0; break; fi
    sleep 1
  done
  echo "=== ЗАМЕЧАНИЯ ПОЛЬЗОВАТЕЛЯ ==="
  if [ "$kept" = 1 ]; then
    cat "$st/out"
    cp "$st/out" "$st/sent"
    echo
    echo "(окно ревью оставлено открытым; в следующем раунде нажми в нём R)"
    return
  fi
  # On q revdiff writes the annotations it still holds. Without R those are the
  # ones already sent, and the diff on screen predates the new commits.
  if [ -s "$st/out" ] && [ -f "$st/sent" ] && cmp -s "$st/out" "$st/sent"; then
    rm -rf "$st"
    echo "⚠ Окно закрыто без R: новые коммиты не показаны. Это не одобрение — запусти раунд заново."
    exit 5
  fi
  if [ -s "$st/out" ]; then cat "$st/out"; else echo "(замечаний нет)"; fi
  rm -rf "$st"
}

run_revdiff() {  # $1 = dir, rest = revdiff args
  local dir="$1"; shift
  . "$HOME/.claude/hooks/lib-tmux-pane.sh"
  if [ -n "$keep_key" ] && [ -n "$CLAUDE_TMUX_PANE" ] && [ "$popup" = 0 ]; then
    run_revdiff_kept "$dir" "$@"
    return
  fi
  local cmd="revdiff --output=$(printf %q "$out") --description-file=$(printf %q "$desc")"
  for a in "$@"; do cmd="$cmd $(printf %q "$a")"; done
  if [ -z "$CLAUDE_TMUX_PANE" ]; then
    echo "Не в tmux. Запусти сам в $dir:"; echo "  $cmd"; exit 3
  fi
  if [ "$popup" = 1 ]; then
    # display-popup держит клиента: пока он открыт, переключиться на другое окно
    # нельзя. Годится для короткого диффа, который читают за один присест.
    tmux display-popup -t "$CLAUDE_TMUX_PANE" -w 95% -h 95% -d "$dir" \
      -T " review: закончить — q " -E "$cmd"
  else
    # Отдельное окно: разметку можно прервать, уйти в другое окно и вернуться.
    # Ждём, пока окно не исчезнет — и когда revdiff закрыт по q, и когда окно
    # убили руками.
    local win sess
    # Claude Code вырезает TMUX из окружения, поэтому "текущая" сессия для tmux —
    # не обязательно та, в которой сидит пользователь. Берём её у его же панели.
    sess="$(tmux display-message -p -t "$CLAUDE_TMUX_PANE" '#{session_id}')"
    win="$(tmux new-window -P -F '#{window_id}' -t "$sess" -c "$dir" -n review "$cmd")"
    while tmux list-windows -a -F '#{window_id}' 2>/dev/null | grep -qx "$win"; do
      sleep 1
    done
  fi
  echo "=== ЗАМЕЧАНИЯ ПОЛЬЗОВАТЕЛЯ ==="
  if [ -s "$out" ]; then cat "$out"; else echo "(замечаний нет)"; fi
}

# revdiff opens the focused file in $EDITOR, and in a text review that file is a
# copy in a throwaway repository: without this the user's edits vanish with it.
# Returns 0 (copy untouched), 7 (edits moved into the draft) or 8 (stop and ask).
edited=0
take_user_edits() {  # $1 = copy, $2 = draft, $3 = file with the draft as shown
  local copy="$1" draft="$2" shown="$3" saved
  if [ ! -f "$copy" ]; then
    echo "✋ Копия черновика в окне ревью пропала — спроси пользователя, правил ли он текст."
    return 8
  fi
  # $(...) drops trailing newlines: an editor adding one is not an edit.
  if [ "$(cat "$copy")" = "$(cat "$shown")" ]; then
    echo "Черновик в окне ревью: не изменён."
    return 0
  fi
  edited=1
  "$HOME/.claude/bin/text-check" --mark-user-owned "$draft" edited-in-review
  echo
  echo "=== ПРАВКА ПОЛЬЗОВАТЕЛЯ В ОКНЕ РЕВЬЮ ==="
  git --no-pager diff --no-index --no-color -- "$shown" "$copy"
  if [ "$(cat "$draft")" != "$(cat "$shown")" ]; then
    saved="${draft%.md}.user-edit.md"
    cp "$copy" "$saved"
    echo "✋ Черновик $draft изменился, пока шло ревью, поэтому правку пользователя в него не переношу."
    echo "   Она сохранена в $saved. Покажи пользователю оба варианта и спроси, какой оставить."
    return 8
  fi
  cp "$copy" "$draft"
  echo "Правка перенесена в $draft. Теперь это текст пользователя: по замечаниям агента его не"
  echo "правь. Внеси замечания пользователя, если они есть, и запусти review text снова — он"
  echo "увидит свой текст и замечания агента к нему."
  return 7
}

# The user says they edited the text by hand, yet nothing changed: the edits are
# somewhere else (another file, an unsaved buffer).
edit_claim='((И|и)зменил|(П|п)оправил|(П|п)равил|(О|о)тредактировал|(П|п)ереписал|(И|и)справил)[^[:space:]]*[[:space:]]+(вручную|руками|сам)'
edit_claim="$edit_claim"'|(вручную|руками|(С|с)ам|(С|с)ама)[[:space:]]+((И|и)зменил|(П|п)оправил|(П|п)равил|(О|о)тредактировал|(П|п)ереписал|(И|и)справил)'
edit_claim="$edit_claim"'|(М|м)(ои|ою|оя)[[:space:]]+(правк|изменени|верси)'

case "$mode" in
branch)
  git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"
  top="$(git rev-parse --show-toplevel)"
  branch="$(git rev-parse --abbrev-ref HEAD)"
  [ "$branch" != HEAD ] || die "detached HEAD — переключись на ветку задачи"
  [ "$branch" != "$target" ] || die "ты на $target, ревьюить нечего"
  if ! git fetch -q origin "$target" 2>/dev/null; then
    echo "⚠ git fetch origin $target не удался (VPN?) — беру локальный origin/$target от $(git log -1 --format=%cr "origin/$target")"
  fi
  base="$(git merge-base "origin/$target" HEAD)" || die "no merge-base with origin/$target"
  count="$(git rev-list --count "$base"..HEAD)"
  [ "$count" -gt 0 ] || die "в ветке $branch нет коммитов поверх origin/$target"
  me="$(git config user.email)"
  {
    echo "Ветка \`$branch\` → \`$target\`: $count коммит(ов) после merge-base ${base:0:10}."
    echo
    git log --reverse --format="%h %ae|%s" "$base"..HEAD | while IFS='|' read -r head subj; do
      sha="${head%% *}"; author="${head#* }"
      if [ "$author" = "$me" ]; then echo "- $sha $subj"; else echo "- ⚠ $sha $subj — автор $author"; fi
    done
  } > "$desc"
  cat "$desc"
  if ! git diff --quiet HEAD 2>/dev/null; then
    echo "⚠ Есть незакоммиченные изменения — в ревью они НЕ попадают."
  fi
  if grep -q '^- ⚠ ' "$desc" && [ "$allow_foreign" = 0 ]; then
    echo "✋ Ревью не запущено: в ветке чужие коммиты (отмечены ⚠). Обычно ветка не перебазирована"
    echo "   на свежий origin/$target. Перебазируй (git rebase origin/$target) или убери их;"
    echo "   если коллега законно работает в этой ветке — спроси пользователя и добавь --allow-foreign."
    exit 4
  fi
  keep_key="$(printf '%s' "$top/$branch" | tr -c 'A-Za-z0-9._-' '_')"
  # Комментарии в коде сначала читает отдельный claude -p без контекста задачи
  # (правило ~/.claude/rules/code-comments.md). Его сбой ревью не останавливает.
  cc_questions="$(mktemp -t review-comments)"
  "$HOME/.claude/bin/comment-check" "$top" "$base" --key "$keep_key" --questions "$cc_questions"
  case $? in
    0) ;;
    3) rm -f "$cc_questions"; exit 6 ;;
    *) echo "⚠ comment-check не отработал — ревью идёт без проверки комментариев. Скажи об этом пользователю." ;;
  esac
  if [ -s "$cc_questions" ]; then
    { echo; cat "$cc_questions"; } >> "$desc"
  fi
  rm -f "$cc_questions"
  if [ "$tool" = diffx ]; then
    cd "$top" && exec diffx -- "$base" HEAD
  fi
  run_revdiff "$top" "$base" HEAD
  ;;
text)
  [ -f "$file" ] || die "no such draft: $file"
  path="$(cd "$(dirname "$file")" && pwd)/$(basename "$file")"
  dir="$(dirname "$path")"
  old="$(mktemp -t review-old)"
  if git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
    rel="$(git -C "$dir" ls-files --full-name -- "$path")"
    [ -n "$rel" ] && git -C "$dir" show "HEAD:$rel" > "$old" 2>/dev/null
  fi
  if [ -s "$old" ]; then echo "Черновик $path: изменения относительно одобренной версии." > "$desc"
  else echo "Черновик $path: новый текст." > "$desc"; fi
  cat "$desc"
  # Сначала черновик проверяет отдельный claude -p со свежим контекстом. Пока есть
  # блокирующие замечания и у автора остались раунды — пользователю не показываем.
  view="$(mktemp -d -t review-view)"
  "$HOME/.claude/bin/text-check" "$path" --view "$view" $check_only $recheck
  case $? in
    0) ;;
    3) rm -rf "$view"; exit 6 ;;
    *) rm -rf "$view"; die "text-check не отработал — ревью не запущено" ;;
  esac
  if [ "$tool" = diffx ]; then
    # diffx показывает working tree репозитория целиком и не умеет читать
    # untracked-файлы (рисует "Binary file untracked"), поэтому каталог черновиков
    # ему показывать нельзя: туда попадут чужие черновики, а свой будет пустым.
    # Собираем одноразовый репозиторий ровно с этим файлом: одобренная версия —
    # в коммите, новая — в рабочем дереве.
    rm -rf "$view"
    work="$(mktemp -d -t review-diffx)"
    name="$(basename "$path")"
    git -C "$work" init -q
    git -C "$work" config user.email review@local
    git -C "$work" config user.name review
    cp "$old" "$work/$name"
    git -C "$work" add -- "$name"
    git -C "$work" commit -q -m "одобренная версия черновика"
    cp "$path" "$work/$name"
    shown="$(mktemp -t review-shown)"
    cp "$path" "$shown"
    ( cd "$work" && diffx )
    rc=$?
    take_user_edits "$work/$name" "$path" "$shown" || rc=$?
    rm -rf "$work"
    exit $rc
  fi
  # Пользователь видит только вопросы проверяющего и то, что в черновике поменялось с
  # прошлого показа. Одноразовый репозиторий из двух коммитов: черновик, каким
  # пользователь видел его в прошлый раз (пустой коммит, если не видел), и поверх —
  # файл вопросов и черновик сейчас.
  work="$(mktemp -d -t review-text)"
  name="$(basename "$path")"
  questions=1-questions.md
  git -C "$work" init -q
  git -C "$work" config user.email review@local
  git -C "$work" config user.name review
  git -C "$work" config core.quotePath false
  if [ -f "$view/seen.md" ]; then
    cp "$view/seen.md" "$work/$name"
    git -C "$work" add -- "$name"
  fi
  git -C "$work" commit -q --allow-empty -m "показано в прошлый раз"
  cp "$view/questions.md" "$work/$questions"
  cp "$path" "$work/$name"
  shown="$(mktemp -t review-shown)"
  cp "$path" "$shown"
  git -C "$work" add -A
  git -C "$work" commit -q -m "сейчас"
  cp "$view/desc.md" "$desc"
  run_revdiff "$work" --wrap --compact --word-diff --line-numbers --cross-file-hunks HEAD~1 HEAD
  # Ответ на вопрос — комментарий к строке файла вопросов, а файл временный:
  # печатаем его с номерами строк, чтобы ответы было к чему привязать.
  if grep -q "^## $questions:" "$out" 2>/dev/null; then
    echo
    echo "=== ВОПРОСЫ (номера строк — к ответам выше) ==="
    git -C "$work" show "HEAD:$questions" | awk '{ printf "%4d  %s\n", NR, $0 }'
  fi
  "$HOME/.claude/bin/text-check" --record-user "$path" "$out" "$view"
  rc=0
  take_user_edits "$work/$name" "$path" "$shown" || rc=$?
  if ! git -C "$work" diff --quiet -- "$questions"; then
    echo
    echo "=== ПОЛЬЗОВАТЕЛЬ ПИСАЛ ПРЯМО В ФАЙЛЕ ВОПРОСОВ ==="
    git -C "$work" --no-pager diff --no-color -- "$questions"
    echo "✋ Это ответы пользователя: разбери их как замечания. Раунд — не одобрение."
    [ "$rc" = 0 ] && rc=8
  fi
  if [ "$edited" = 0 ] && grep -qE "$edit_claim" "$out" 2>/dev/null; then
    echo "✋ Пользователь пишет, что правил текст, но ни копия в окне ревью, ни черновик не"
    echo "   изменились. Правки где-то ещё: спроси, где они, и не продолжай по своей версии."
    rc=8
  fi
  rm -rf "$work" "$view"
  exit $rc
  ;;
*)
  sed -n '2,24p' "$0"; exit 2 ;;
esac
