#!/usr/bin/env python3
"""Mark text or a git commit as reviewed by the user, for publish-gate.py.

  publish-approve <draft-file>          approve the file's exact text
  publish-approve --git <repo> <ref>    approve the commit <ref> points to

Each call is confirmed by the user (publish-gate returns "ask" for it).
Approved drafts are committed in ~/.claude/state/publish, so the next
revision of the same draft shows up in diffx as a diff.

A draft of a new Jira issue may start with a `**Summary:** …` line, so the
user reviews the title together with the description. The title goes to its
own field, so the text after that line is approved too.
"""
import json
import os
import re
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import importlib.util  # noqa: E402
from importlib.machinery import SourceFileLoader  # noqa: E402

# SourceFileLoader.load_module() is gone in Python 3.15.
_loader = SourceFileLoader(
    "publish_gate", os.path.join(os.path.dirname(os.path.realpath(__file__)), "publish-gate.py")
)
gate = importlib.util.module_from_spec(importlib.util.spec_from_loader(_loader.name, _loader))
sys.modules[_loader.name] = gate
_loader.exec_module(gate)

SUMMARY_LINE = re.compile(r"\A\s*\*\*Summary:\*\*[^\n]*\n")


def mark(name, label):
    os.makedirs(gate.APPROVED, exist_ok=True)
    with open(os.path.join(gate.APPROVED, name), "w") as f:
        f.write(label + "\n")
    print(f"approved: {label} ({name[:16]})")


def main(argv):
    if len(argv) == 3 and argv[0] == "--git":
        repo, ref = argv[1], argv[2]
        sha = gate.git_head(os.path.expanduser(repo), ref)
        if not sha:
            sys.exit(f"no commit for {ref!r} in {repo}")
        mark("git-" + sha, f"{repo} {ref} {sha}")
        return
    if len(argv) != 1:
        sys.exit(__doc__)
    path = os.path.realpath(os.path.expanduser(argv[0]))
    with open(path, encoding="utf-8") as f:
        text = f.read()
    if not gate.normalize(text):
        sys.exit("empty draft")
    record = os.path.join(gate.CHECKS, gate.digest(text) + ".json")
    if not os.path.exists(record):
        sys.exit("этот текст не прошёл проверку агентом: запусти "
                 f"`{gate.REVIEW_CMD} text {argv[0]}` и дождись ревью пользователя")
    with open(record, encoding="utf-8") as f:
        checked = json.load(f)
    # A record with the reader's verdict only means the author was sent back before the facts
    # were checked. Records made before the reader stage keep the claims at the top level.
    if not ("facts" in checked or "claims" in checked or checked.get("skipped")):
        sys.exit("факты этого текста агент не проверял (читатель вернул его автору): запусти "
                 f"`{gate.REVIEW_CMD} text {argv[0]}`")
    mark(gate.digest(text), path)
    body = SUMMARY_LINE.sub("", text, count=1)
    if body != text and gate.normalize(body):
        mark(gate.digest(body), f"{path} без строки Summary")
    subprocess.run([os.path.expanduser("~/.claude/bin/text-check"), "--record-approve", path],
                   check=False)
    if path.startswith(os.path.realpath(gate.STATE) + os.sep):
        subprocess.run(["git", "-C", gate.STATE, "add", path], check=False)
        subprocess.run(["git", "-C", gate.STATE, "commit", "-qm", f"approve {os.path.basename(path)}"],
                       check=False)


if __name__ == "__main__":
    main(sys.argv[1:])
