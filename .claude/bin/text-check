#!/usr/bin/env python3
"""Check a text draft by a separate Claude with a fresh context, before the user sees it.

  text-check <draft> --view <dir> [--check-only]
                                         check the draft's current text (or reuse the check
                                         already made for exactly this text), print the report
                                         for the author, write the user's view into <dir>;
                                         --check-only marks the text as the user's (see below)
  text-check --record-user <draft> <annotations-file> <dir>
                                         log how many remarks the user made in revdiff
  text-check --mark-user-owned <draft> <reason>
                                         mark the text as the user's until its approval
  text-check --record-approve <draft>    log the approval (called by publish-approve)

The reviewer is `claude -p` with read-only tools and a JSON schema: every factual claim of the
draft is listed as confirmed / unconfirmed / contradicted, every problem comes with a ready
edit and says who decides it — the author (fixes it before the user sees anything) or the user
(only the user knows the answer, and it changes what the reader understands or does). Sources
come from `<draft>.sources.md`, written by the author next to the draft.

Exit codes of a check: 0 — show the view to the user; 3 — there are items for the author and
the author still has rounds left (MAX_AUTHOR_ROUNDS since the user's last review): apply them
and run `review text` again; 2 — error.

A text is the user's once they edited it in the review window (the wrapper marks it) or asked
only to check it (`--check-only`), until it is approved. The author does not edit such a text by
the checker's items: a check never returns 3 for it, and every item, minor included, goes to the
user, who answers «да» on the ones to apply.

The user's view (<dir>): `questions.md` with only what the user has to decide, `seen.md` with
the draft as the user saw it last time (absent on the first showing), `desc.md` for the revdiff
info popup, `meta.json` for --record-user.

State: ~/.claude/state/publish/checks/<digest>.json (protected by publish-gate) and
~/.claude/state/publish/stats.jsonl (one line per check, user review and approval).
"""
import json
import os
import subprocess
import sys
import time
from importlib.machinery import SourceFileLoader

gate = SourceFileLoader(
    "publish_gate", os.path.expanduser("~/.claude/hooks/publish-gate.py")).load_module()

# TEXT_CHECK_STATE — only for trying the script out without touching the real stats.
STATE = os.environ.get("TEXT_CHECK_STATE", gate.STATE)
CHECKS = os.path.join(STATE, "checks")
STATS = os.path.join(STATE, "stats.jsonl")
PROMPT = os.path.expanduser("~/.claude/review/text-check-prompt.md")
# The cyrillization rule with both word lists lives in the user's CLAUDE.md; the checker gets
# the current section verbatim instead of being asked to go and read it.
RULES = os.path.expanduser("~/.claude/CLAUDE.md")
RULES_HEADING = "### Кириллизация английских слов"
MODEL = "opus"
MAX_AUTHOR_ROUNDS = 2
BUDGET_USD = "3"
READ_TOOLS = [
    "Read", "Grep", "Glob",
    "Bash(git log:*)", "Bash(git show:*)", "Bash(git diff:*)",
    "Bash(ls:*)", "Bash(cat:*)", "Bash(grep:*)", "Bash(rg:*)",
    # `cd repo && git …` and `git -C` are not allowed; git-ro runs read-only subcommands only.
    "Bash(~/.claude/bin/git-ro:*)", f"Bash({os.path.expanduser('~/.claude/bin/git-ro')}:*)",
]
# Read-only dirs outside ~/projects the checker may need: installed gem sources.
EXTRA_DIRS = [d for d in [os.path.expanduser("~/.rvm/gems")] if os.path.isdir(d)]
KINDS = ["fact", "unclear", "missing", "wrong-audience", "language", "redundant", "tone"]
SCHEMA = {
    "type": "object",
    "required": ["claims", "issues", "summary"],
    "properties": {
        "claims": {"type": "array", "items": {
            "type": "object",
            "required": ["claim", "status", "evidence"],
            "properties": {
                "claim": {"type": "string"},
                "status": {"enum": ["confirmed", "unconfirmed", "contradicted"]},
                "evidence": {"type": "string"},
            },
        }},
        "issues": {"type": "array", "items": {
            "type": "object",
            "required": ["kind", "severity", "decide", "reason", "edits", "question"],
            "properties": {
                "kind": {"enum": KINDS},
                "severity": {"enum": ["blocker", "doubt", "minor"]},
                "decide": {"enum": ["author", "user"]},
                "reason": {"type": "string"},
                # Every place of the same problem, each with its exact replacement.
                "edits": {"type": "array", "items": {
                    "type": "object",
                    "required": ["quote", "replacement"],
                    "properties": {
                        "quote": {"type": "string"},
                        "replacement": {"type": "string"},
                    },
                }},
                "question": {"type": "string"},
            },
        }},
        "summary": {"type": "string"},
    },
}


def now():
    return time.strftime("%Y-%m-%dT%H:%M:%S")


def log(event, draft, **fields):
    with open(STATS, "a", encoding="utf-8") as f:
        f.write(json.dumps({"event": event, "ts": now(), "draft": draft, **fields},
                           ensure_ascii=False) + "\n")


def history(draft):
    """Events for this draft since its last approval."""
    events = []
    if os.path.exists(STATS):
        with open(STATS, encoding="utf-8") as f:
            for line in f:
                e = json.loads(line)
                if e.get("draft") != draft:
                    continue
                if e["event"] == "approve":
                    events = []
                else:
                    events.append(e)
    return events


def read(path):
    with open(path, encoding="utf-8") as f:
        return f.read()


def language_rules():
    """The cyrillization section of RULES, from its heading up to the next heading."""
    lines = read(RULES).split("\n")
    start = next((i for i, line in enumerate(lines) if line.startswith(RULES_HEADING)), None)
    if start is None:
        sys.exit(f"text-check: в {RULES} нет раздела «{RULES_HEADING}» — проверяющему "
                 "нечем проверять кириллизацию. Поправь RULES_HEADING.")
    end = next((i for i in range(start + 1, len(lines))
                if lines[i].startswith(("# ", "## ", "### "))), len(lines))
    return "\n".join(lines[start:end]).strip()


def run_reviewer(draft, text):
    sources_path = draft[:-3] + ".sources.md" if draft.endswith(".md") else draft + ".sources.md"
    sources = read(sources_path) if os.path.exists(sources_path) else "(файла источников нет)"
    numbered = "\n".join(f"{i:4}  {line}" for i, line in enumerate(text.split("\n"), 1))
    task = (
        f"Черновик ({draft}), с номерами строк:\n\n{numbered}\n\n"
        f"Файл источников автора ({sources_path}):\n\n{sources}\n"
    )
    prompt = (f"{read(PROMPT)}\n\n## Правило о кириллизации (из {RULES}, дословно)\n\n"
              f"{language_rules()}\n")
    cmd = [
        "claude", "-p", "--model", MODEL, "--no-session-persistence",
        "--output-format", "json", "--json-schema", json.dumps(SCHEMA),
        "--append-system-prompt", prompt,
        "--strict-mcp-config", "--setting-sources", "",
        "--max-budget-usd", BUDGET_USD,
        *[a for d in EXTRA_DIRS for a in ("--add-dir", d)],
        "--allowedTools", *READ_TOOLS,
    ]
    started = time.time()
    proc = subprocess.run(cmd, input=task, capture_output=True, text=True,
                          cwd=os.path.expanduser("~/projects"), timeout=1800)
    if proc.returncode != 0:
        sys.exit(f"text-check: claude -p завершился с кодом {proc.returncode}:\n"
                 f"{proc.stderr[-2000:]}{proc.stdout[-2000:]}")
    out = json.loads(proc.stdout)
    result = out.get("structured_output")
    if not isinstance(result, dict):
        sys.exit(f"text-check: проверяющий не вернул ответ по схеме:\n{proc.stdout[-2000:]}")
    result["meta"] = {
        "model": MODEL, "cost_usd": out.get("total_cost_usd"),
        "duration_s": round(time.time() - started), "sources": os.path.exists(sources_path),
        **tokens(out.get("modelUsage") or {}),
    }
    return result


def tokens(model_usage):
    """Token totals of a `claude -p` run (all models it called), plus the per-model split."""
    keys = {"inputTokens": "input_tokens", "outputTokens": "output_tokens",
            "cacheReadInputTokens": "cache_read_tokens",
            "cacheCreationInputTokens": "cache_creation_tokens"}
    total = {v: sum(m.get(k, 0) for m in model_usage.values()) for k, v in keys.items()}
    total["by_model"] = {name: {v: m.get(k, 0) for k, v in keys.items()}
                         for name, m in model_usage.items()}
    return total


def line_of(text, quote):
    pos = text.find(quote.strip()) if quote.strip() else -1
    return text.count("\n", 0, pos) + 1 if pos >= 0 else None


def where(text, quotes):
    lines = sorted({n for n in (line_of(text, q) for q in quotes) if n})
    if not lines:
        return "место не найдено"
    return "стр. " + ", ".join(map(str, lines))


def for_author(check):
    return [i for i in check["issues"] if i["decide"] == "author"]


def for_user(check):
    return [i for i in check["issues"] if i["decide"] == "user"]


def counts(check):
    claims = check["claims"]
    issues = check["issues"]
    return {
        "claims": len(claims),
        "confirmed": sum(c["status"] == "confirmed" for c in claims),
        "unconfirmed": sum(c["status"] == "unconfirmed" for c in claims),
        "contradicted": sum(c["status"] == "contradicted" for c in claims),
        "blockers": sum(i["severity"] == "blocker" for i in issues),
        "doubts": sum(i["severity"] == "doubt" for i in issues),
        "minor": sum(i["severity"] == "minor" for i in issues),
        "for_author": len(for_author(check)),
        "for_user": len(for_user(check)),
    }


def edit_line(e, prefix="   "):
    if e["replacement"] and e["replacement"] != e["quote"]:
        return f"{prefix}«{e['quote']}» → «{e['replacement']}»"
    return f"{prefix}«{e['quote']}»"


def format_issue(n, issue, text):
    quotes = [e["quote"] for e in issue["edits"]]
    out = [f"{n}. [{issue['severity']} · {issue['kind']}] {where(text, quotes)}: {issue['reason']}"]
    out += [edit_line(e) for e in issue["edits"]]
    if issue["question"]:
        out.append(f"   Вопрос: {issue['question']}")
    return "\n".join(out) + "\n"


def user_owned(events):
    """Why the text is the user's since its last approval, or None."""
    marks = [e["reason"] for e in events if e["event"] == "user_owned"]
    return marks[-1] if marks else None


OWNED_REASONS = {
    "edited-in-review": "пользователь правил его в окне ревью",
    "check-only": "пользователь просил только проверить",
}


def author_report(check, text, author_round, bounce, owned):
    c = counts(check)
    out = ["=== ПРОВЕРКА АГЕНТОМ ==="]
    if owned:
        out += [f"Текст пользователя ({OWNED_REASONS.get(owned, owned)}): правки агента НЕ вносишь, "
                "все замечания показаны пользователю, он отметит «да» те, что внести.", ""]
    out += [f"Раунд автора {author_round} (лимит {MAX_AUTHOR_ROUNDS}) · {check['meta']['model']} · "
           f"источники: {'есть' if check['meta']['sources'] else 'НЕТ'}",
           f"Утверждений {c['claims']}: подтверждено {c['confirmed']}, "
           f"не подтверждено {c['unconfirmed']}, противоречит {c['contradicted']}.",
           f"Замечаний автору {c['for_author']}, вопросов пользователю {c['for_user']}.",
           "", check["summary"], ""]
    if for_author(check):
        out.append("Автору:")
        out += [format_issue(n, i, text) for n, i in enumerate(for_author(check), 1)]
    if for_user(check):
        out.append("Пользователю:")
        out += [format_issue(n, i, text) for n, i in enumerate(for_user(check), 1)]
    bad = [cl for cl in check["claims"] if cl["status"] != "confirmed"]
    if bad:
        out.append("Неподтверждённые утверждения:")
        out += [f"- [{cl['status']}] {cl['claim']} — {cl['evidence']}" for cl in bad]
    if not bounce and not owned and for_author(check):
        left = [i for i in for_author(check) if i["severity"] == "minor"]
        if left:
            out.append(f"\nПравок автора больше не будет: косметика ({len(left)}) не вносится и "
                       "пользователю не показывается. Черновик больше не правь — текст уже "
                       "в ревью; правка запустит новый раунд проверки.")
    return "\n".join(out)


def shown_to_user(check, owned):
    """Questions for the user, plus author items the author did not close: the important ones,
    or all of them, unconfirmed claims included, when the text is the user's."""
    if owned:
        return for_user(check), for_author(check), [
            cl for cl in check["claims"] if cl["status"] != "confirmed"]
    return for_user(check), [i for i in for_author(check) if i["severity"] != "minor"], []


def questions_view(check, text, draft, questions, leftover, claims, owned):
    out = [f"# Вопросы к тебе: {os.path.basename(draft)}", ""]
    if not questions and not leftover and not claims:
        out += ["Вопросов нет. " + ("Замечаний к тексту у агента нет." if owned else
                                    "Мелкие правки агент и автор внесли сами."), "",
                "Черновик — во втором файле: изменения с прошлого показа (при первом показе — "
                "весь текст). Читать не обязательно. Согласен — закрой по q."]
        return "\n".join(out) + "\n"
    out += ["Ответь комментарием на строке вопроса; без комментария — оставить как в тексте. "
            "Черновик — во втором файле, номера строк — по нему.", ""]
    if owned:
        out += ["Текст твой, автор его по замечаниям агента не правил. Правку агента внесут, "
                "только если ответишь на её строке «да».", ""]
    for n, i in enumerate(questions, 1):
        quotes = [e["quote"] for e in i["edits"]]
        out.append(f"{n}. {where(text, quotes)}: {i['question'] or i['reason']}")
        out += [edit_line(e, "   вариант агента: ") for e in i["edits"]
                if e["replacement"] and e["replacement"] != e["quote"]]
        out.append("")
    if leftover:
        out += ["## Правки агента" if owned else
                "## Правки агента, которые автор не закрыл за раунды", ""]
        for n, i in enumerate(leftover, len(questions) + 1):
            quotes = [e["quote"] for e in i["edits"]]
            out.append(f"{n}. [{i['severity']} · {i['kind']}] {where(text, quotes)}: {i['reason']}"
                       if owned else f"{n}. {where(text, quotes)}: {i['reason']}")
            out += [edit_line(e) for e in i["edits"]]
            out.append("")
    if claims:
        out += ["## Утверждения, которые агент не подтвердил", ""]
        for n, cl in enumerate(claims, len(questions) + len(leftover) + 1):
            out.append(f"{n}. [{cl['status']}] {cl['claim']} — {cl['evidence']}")
            out.append("")
    return "\n".join(out)


def stored_check(digest):
    path = os.path.join(CHECKS, digest + ".json")
    return json.loads(read(path)) if os.path.exists(path) else None


def seen_text(events):
    """The text of the draft the user reviewed last (since its last approval), if any."""
    for e in reversed(events):
        if e["event"] == "user_review":
            prior = stored_check(e["digest"])
            return prior.get("text") if prior else None
    return None


def author_round_of(events, digest):
    """Which author round this text is: distinct checked texts since the user's last review."""
    since = []
    for e in events:
        if e["event"] == "user_review":
            since = []
        elif e["event"] == "check":
            since.append(e["digest"])
    known = list(dict.fromkeys(since))
    return known.index(digest) + 1 if digest in known else len(known) + 1


def mark_user_owned(draft, reason, events):
    if user_owned(events) != reason:
        log("user_owned", draft, reason=reason)


def check(draft, view_dir, check_only):
    text = read(draft)
    if not gate.normalize(text):
        sys.exit("text-check: пустой черновик")
    digest = gate.digest(text)
    os.makedirs(CHECKS, exist_ok=True)
    events = history(draft)
    if check_only:
        mark_user_owned(draft, "check-only", events)
        events = history(draft)
    owned = user_owned(events)
    result = stored_check(digest)
    if result and any("decide" not in i for i in result["issues"]):
        result = None  # made by the previous version of the checker: check again
    if result:
        # The same text again: the author has seen the items and chose to leave them, so
        # whatever is still important goes to the user instead of bouncing forever.
        print("(текст не менялся с прошлой проверки — беру её результат; "
              "оставшиеся важные замечания уйдут пользователю)")
        author_round = result.get("author_round", result["round"])
        bounce = False
    else:
        author_round = author_round_of(events, digest)
        print(f"Проверяю черновик агентом ({MODEL}, раунд автора {author_round})… "
              "это займёт несколько минут.", flush=True)
        result = run_reviewer(draft, text)
        result["round"] = len({e["digest"] for e in events if e["event"] == "check"}) + 1
        result["author_round"] = author_round
        result["draft"] = draft
        result["text"] = text
        with open(os.path.join(CHECKS, digest + ".json"), "w", encoding="utf-8") as f:
            json.dump(result, f, ensure_ascii=False, indent=1)
        bounce = (not owned and bool(for_author(result))
                  and author_round <= MAX_AUTHOR_ROUNDS)
        log("check", draft, digest=digest, round=result["round"], author_round=author_round,
            bounced=bounce, user_owned=owned, **counts(result), **result["meta"])
    if owned:
        bounce = False
    print(author_report(result, text, author_round, bounce, owned))
    if bounce:
        print(f"\n✋ Есть замечания автору (раунд {author_round} из {MAX_AUTHOR_ROUNDS}). "
              "Пользователю текст не показан. Если пользователь правил текст сам или просил "
              "только проверить — ничего не правь и запусти `review text --check-only`: "
              "замечания уйдут ему. Иначе внеси правки агента — по своему суждению, косметику "
              "тоже; для неподтверждённых утверждений добавь выдержки в файл источников или "
              "убери утверждение. Потом запусти `review text` снова.")
        sys.exit(3)
    questions, leftover, claims = shown_to_user(result, owned)
    os.makedirs(view_dir, exist_ok=True)
    with open(os.path.join(view_dir, "questions.md"), "w", encoding="utf-8") as f:
        f.write(questions_view(result, text, draft, questions, leftover, claims, owned))
    seen = seen_text(events)
    if seen is not None:
        with open(os.path.join(view_dir, "seen.md"), "w", encoding="utf-8") as f:
            f.write(seen)
    shown = len(questions) + len(leftover) + len(claims)
    changes = ("весь текст" if seen is None else
               "изменений с прошлого показа нет" if seen == text else "изменения с прошлого показа")
    with open(os.path.join(view_dir, "desc.md"), "w", encoding="utf-8") as f:
        f.write(f"Черновик {draft}. Вопросов к тебе: {shown}. Источники: "
                f"{'есть' if result['meta']['sources'] else 'НЕТ'}. Первый файл — вопросы, "
                f"второй — черновик: {changes}.\n")
    with open(os.path.join(view_dir, "meta.json"), "w") as f:
        json.dump({"digest": digest, "round": result["round"], "shown": shown}, f)


def record_user(draft, annotations, view_dir):
    with open(os.path.join(view_dir, "meta.json")) as f:
        meta = json.load(f)
    remarks = 0
    if os.path.exists(annotations):
        remarks = sum(1 for line in read(annotations).split("\n") if line.startswith("## "))
    log("user_review", draft, digest=meta["digest"], round=meta["round"],
        shown=meta["shown"], user_remarks=remarks)


def main(argv):
    if len(argv) == 4 and argv[0] == "--record-user":
        record_user(os.path.realpath(argv[1]), argv[2], argv[3])
    elif len(argv) == 2 and argv[0] == "--record-approve":
        draft = os.path.realpath(argv[1])
        log("approve", draft, digest=gate.digest(read(draft)))
    elif len(argv) == 3 and argv[0] == "--mark-user-owned" and argv[2] in OWNED_REASONS:
        draft = os.path.realpath(argv[1])
        mark_user_owned(draft, argv[2], history(draft))
    elif len(argv) in (3, 4) and argv[1] == "--view" and argv[3:] in ([], ["--check-only"]):
        check(os.path.realpath(argv[0]), argv[2], argv[3:] == ["--check-only"])
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
