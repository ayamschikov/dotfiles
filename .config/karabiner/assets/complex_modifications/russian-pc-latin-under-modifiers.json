{
  "title": "Russian — PC: force English layout under Cmd / Ctrl / Opt",
  "rules": [
    {
      "description": "While ⌘/⌃/⌥ is held and Russian — PC is active, temporarily switch to ABC (English). Restores Russian — PC on release. Makes Ctrl+[, Cmd+C, Ctrl+R, etc. work the same on any layout.",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "left_command", "modifiers": { "optional": ["any"] } },
          "to": [
            { "select_input_source": { "input_source_id": "^com\\.apple\\.keylayout\\.ABC$" } },
            { "key_code": "left_command" }
          ],
          "to_after_key_up": [
            { "select_input_source": { "input_source_id": "^com\\.apple\\.keylayout\\.RussianWin$" } }
          ],
          "conditions": [
            { "type": "input_source_if", "input_sources": [{ "input_source_id": "^com\\.apple\\.keylayout\\.RussianWin$" }] }
          ]
        },
        {
          "type": "basic",
          "from": { "key_code": "right_command", "modifiers": { "optional": ["any"] } },
          "to": [
            { "select_input_source": { "input_source_id": "^com\\.apple\\.keylayout\\.ABC$" } },
            { "key_code": "right_command" }
          ],
          "to_after_key_up": [
            { "select_input_source": { "input_source_id": "^com\\.apple\\.keylayout\\.RussianWin$" } }
          ],
          "conditions": [
            { "type": "input_source_if", "input_sources": [{ "input_source_id": "^com\\.apple\\.keylayout\\.RussianWin$" }] }
          ]
        },
        {
          "type": "basic",
          "from": { "key_code": "left_control", "modifiers": { "optional": ["any"] } },
          "to": [
            { "select_input_source": { "input_source_id": "^com\\.apple\\.keylayout\\.ABC$" } },
            { "key_code": "left_control" }
          ],
          "to_after_key_up": [
            { "select_input_source": { "input_source_id": "^com\\.apple\\.keylayout\\.RussianWin$" } }
          ],
          "conditions": [
            { "type": "input_source_if", "input_sources": [{ "input_source_id": "^com\\.apple\\.keylayout\\.RussianWin$" }] }
          ]
        },
        {
          "type": "basic",
          "from": { "key_code": "right_control", "modifiers": { "optional": ["any"] } },
          "to": [
            { "select_input_source": { "input_source_id": "^com\\.apple\\.keylayout\\.ABC$" } },
            { "key_code": "right_control" }
          ],
          "to_after_key_up": [
            { "select_input_source": { "input_source_id": "^com\\.apple\\.keylayout\\.RussianWin$" } }
          ],
          "conditions": [
            { "type": "input_source_if", "input_sources": [{ "input_source_id": "^com\\.apple\\.keylayout\\.RussianWin$" }] }
          ]
        },
        {
          "type": "basic",
          "from": { "key_code": "left_option", "modifiers": { "optional": ["any"] } },
          "to": [
            { "select_input_source": { "input_source_id": "^com\\.apple\\.keylayout\\.ABC$" } },
            { "key_code": "left_option" }
          ],
          "to_after_key_up": [
            { "select_input_source": { "input_source_id": "^com\\.apple\\.keylayout\\.RussianWin$" } }
          ],
          "conditions": [
            { "type": "input_source_if", "input_sources": [{ "input_source_id": "^com\\.apple\\.keylayout\\.RussianWin$" }] }
          ]
        },
        {
          "type": "basic",
          "from": { "key_code": "right_option", "modifiers": { "optional": ["any"] } },
          "to": [
            { "select_input_source": { "input_source_id": "^com\\.apple\\.keylayout\\.ABC$" } },
            { "key_code": "right_option" }
          ],
          "to_after_key_up": [
            { "select_input_source": { "input_source_id": "^com\\.apple\\.keylayout\\.RussianWin$" } }
          ],
          "conditions": [
            { "type": "input_source_if", "input_sources": [{ "input_source_id": "^com\\.apple\\.keylayout\\.RussianWin$" }] }
          ]
        }
      ]
    }
  ]
}
